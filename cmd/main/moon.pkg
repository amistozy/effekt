import {
  "amistozy/effekt/src/util",
  "amistozy/effekt/src/source",
  "amistozy/effekt/src/namer",
  "amistozy/effekt/src/typer",
  "amistozy/effekt/src/backend",
  "amistozy/effekt/src/compiler",
}

pkgtype(kind: "executable")

// `moonbitlang/x` pulls Node.js builtins in with `#module(...)`, which makes
// the backend emit `import` statements and therefore an ES module. The
// programs this compiler generates are CommonJS scripts (`module.exports`),
// the runner scripts require them, and the CLI is started with plain `node`,
// so the compiler itself is linked as CommonJS too.

options(
  link: { "js": { "format": "cjs" } },
)
