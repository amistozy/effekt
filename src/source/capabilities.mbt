// Translating a typed program into explicit capability-passing style.
//
// Mirrors `effekt/source/ExplicitCapabilities.scala`. After this phase
//
//   - there are no `Do` nodes left (they become method calls on a capability),
//   - `l.foo(x)` where `foo` is a field is desugared to `l.foo`,
//   - every function / block literal / operation clause binds one block
//     parameter per effect it performs, and every call site passes the
//     corresponding capabilities.
//
// The type checker is responsible for filling in the annotations that this
// phase consumes (see `Context.bound_capabilities_of` etc.).

///|
pub fn explicit_capabilities(
  module : ModuleDecl,
  ctx : Context,
) -> ModuleDecl raise EffektError {
  rewrite_module(module, ctx, capabilities_hooks())
}

///|
/// The hooks of this phase, as a value: the implicit arguments generated by the
/// type checker are not part of the tree this phase visits, so they are
/// rewritten with the same hooks when they are spliced in (upstream rewrites
/// them the same way in `ExplicitCapabilities.expr`).
fn capabilities_hooks() -> Hooks {
  {
    expr: Some(capabilities_expr),
    stmt: None,
    defn: Some((ctx, d) => capabilities_def(ctx, d)),
  }
}

///|
fn rewrite_generated(ctx : Context, t : Term) -> Term raise EffektError {
  rewrite_term(t, ctx, capabilities_hooks())
}

///|
/// The arguments of a call node once `ExplicitCapabilities` has run: the
/// implicit arguments that were appended at the call site, followed by the
/// capability arguments recorded for this node. The three call arms below
/// differ only in the node they build, so the expansion is shared.
fn expanded_arguments(
  ctx : Context,
  t : Term,
  vargs : Array[ValueArg],
  bargs : Array[Term],
) -> (Array[TypeTree], Array[ValueArg], Array[Term]) raise EffektError {
  let extra_v = ctx
    .implicit_value_args_of(t.uid)
    .map(a => rewrite_generated(ctx, a))
  let extra_b = ctx
    .implicit_block_args_of(t.uid)
    .map(a => rewrite_generated(ctx, a))
  let capability_args = ctx
    .capability_arguments_of(t.uid)
    .map(cap => reference_to_capability(cap, ctx))
  let type_args = ctx
    .type_arguments_of(t.uid)
    .map(e => mk_type(Span::missing(), ValueTypeTree(e)))
  (
    type_args,
    vargs + extra_v.map(a => ValueArg::unnamed(a)),
    bargs + extra_b + capability_args,
  )
}

///|
fn capabilities_expr(ctx : Context, t : Term) -> Term? raise EffektError {
  match t.kind {
    // An effect call: dispatch on the inferred capability.
    Do(id, _targs, vargs, bargs) => {
      let (type_args, value_args, block_args) = expanded_arguments(
        ctx, t, vargs, bargs,
      )
      let receiver = match ctx.capability_receiver_of(t.uid) {
        Some(cap) => reference_to_capability(cap, ctx)
        None => mk_term(Span::missing(), Var(id))
      }
      Some(
        mk_term(
          t.span.synthesized(),
          MethodCall(receiver, id, type_args, value_args, block_args),
        ),
      )
    }

    // `f(receiver)` where `f` is a field selector becomes a selection.
    //
    // This arm must be guarded on the callee actually being a `Field`:
    // upstream does the same (`case c @ Call(fun: IdTarget, ...) if
    // fun.definition.isInstanceOf[Field]`). Without the guard it swallows every
    // named call, and the general `Call` arm below — the one that inserts the
    // capability arguments — would never run.
    Call(IdTarget(fun), _targs, vargs, bargs) if is_field_call(
        ctx, fun, vargs, bargs,
      ) => Some(mk_term(t.span.synthesized(), Select(vargs[0].value, fun)))
    // The shape of a method call follows from the candidate the typer resolved
    // it to and from the kind of the receiver (upstream `ExplicitCapabilities`):
    // a value (or a mutable variable) is called through its box, an operation as
    // a method of the receiver's interface, and a function or a computation by
    // passing the receiver as its first argument.
    MethodCall(receiver, id, _targs, vargs, bargs) => {
      let (type_args, value_args, block_args) = expanded_arguments(
        ctx, t, vargs, bargs,
      )
      let shape = match ctx.symbol_of(id.uid) {
        // a field is selected, not called (upstream `case _: Field => Select(...)`)
        Some(@symbols.Sym::Field(_)) => Select(receiver, id)
        Some(sym) =>
          if sym.is_value_symbol() || sym.is_ref_binder() {
            let callee = reference_to_value(sym, ctx)
            if is_block_like(ctx, receiver) {
              Call(
                ExprTarget(mk_term(t.span.synthesized(), Unbox(callee))),
                type_args,
                value_args,
                [receiver] + block_args,
              )
            } else {
              Call(
                ExprTarget(mk_term(t.span.synthesized(), Unbox(callee))),
                type_args,
                [ValueArg::unnamed(receiver)] + value_args,
                block_args,
              )
            }
          } else if sym.is_operation() {
            MethodCall(
              as_block(ctx, receiver),
              id,
              type_args,
              value_args,
              block_args,
            )
          } else if is_block_like(ctx, receiver) {
            Call(IdTarget(id), type_args, value_args, [receiver] + block_args)
          } else {
            Call(
              IdTarget(id),
              type_args,
              [ValueArg::unnamed(receiver)] + value_args,
              block_args,
            )
          }
        None => Call(IdTarget(id), type_args, value_args, block_args)
      }
      Some(mk_term(t.span, shape))
    }
    Call(target, _targs, vargs, bargs) => {
      let (type_args, value_args, block_args) = expanded_arguments(
        ctx, t, vargs, bargs,
      )
      Some(mk_term(t.span, Call(target, type_args, value_args, block_args)))
    }
    // The bodies below have already been rewritten by the generic traversal; the
    // hook only has to add the capability parameters that
    // `ExplicitCapabilities` introduces at handler and function definitions.
    // Re-running the traversal here would append them a second time (and, for
    // the `try` node itself, look up capabilities that were already consumed).
    TryHandle(prog, handlers) => {
      let capabilities = ctx.bound_capabilities_of(t.uid)
      if capabilities.length() != handlers.length() {
        ctx.panic(
          "expected as many capabilities as handlers in try/handle, got \{capabilities.length()} and \{handlers.length()}",
        )
      }
      let new_handlers = handlers.mapi((i, h) => {
        ..h,
        capability: Some(definition_for_capability(capabilities[i], ctx)),
        implementation: with_clause_capabilities(h.implementation, ctx),
      })
      Some(mk_term(t.span, TryHandle(prog, new_handlers)))
    }
    New(implementation) =>
      Some(mk_term(t.span, New(with_clause_capabilities(implementation, ctx))))
    BlockLiteral(tparams, vparams, bparams, body) => {
      let caps = ctx
        .bound_capabilities_of(t.uid)
        .map(cap => definition_for_capability(cap, ctx))

      Some(
        mk_term(t.span, BlockLiteral(tparams, vparams, bparams + caps, body)),
      )
    }
    _ => None
  }
}

///|
/// Adds the capability parameters that the clauses of a handler implementation
/// bind (upstream: the `New` case of `ExplicitCapabilities`). The clause bodies
/// themselves are already rewritten.
fn with_clause_capabilities(
  implementation : Implementation,
  ctx : Context,
) -> Implementation {
  let clauses = implementation.clauses.map(c => {
    let caps = ctx
      .bound_capabilities_of(c.uid)
      .map(cap => definition_for_capability(cap, ctx))
    { ..c, bparams: c.bparams + caps, }
  })
  { ..implementation, clauses, }
}

///|
/// Is this call really a field selection in disguise, i.e. `f(receiver)` where
/// `f` resolved to a `Field` symbol? Upstream guards its corresponding case the
/// same way (`fun.definition.isInstanceOf[Field]`).
fn is_field_call(
  ctx : Context,
  fun : IdRef,
  vargs : ArrayView[ValueArg],
  bargs : ArrayView[Term],
) -> Bool {
  guard vargs.length() == 1 && bargs.is_empty() else { return false }
  match ctx.symbol_of(fun.uid) {
    Some(Field(_)) => true
    _ => false
  }
}

///|
/// Whether a term is a computation, as `UnboxInference.isBlockLike` decides it
/// (`src/typer/unbox.mbt` has the same predicate for the unbox pass): a variable
/// of block type, an unboxed value and a `new` are computations, a value (and a
/// mutable variable) is not.
fn is_block_like(ctx : Context, e : Term) -> Bool {
  match e.kind {
    Var(id) =>
      match ctx.symbol_of(id.uid) {
        Some(sym) => sym.is_block_symbol() && !sym.is_ref_binder()
        None => false
      }
    Unbox(_) | New(_) => true
    _ => false
  }
}

///|
/// The receiver of a method call as a computation (upstream
/// `UnboxInference.asBlock`): a value is unboxed first.
fn as_block(ctx : Context, receiver : Term) -> Term {
  if is_block_like(ctx, receiver) {
    receiver
  } else {
    mk_term(receiver.span.synthesized(), Unbox(receiver))
  }
}

///|
/// A term referencing a value (or a mutable variable) bound in the environment,
/// annotated with its type: calling it unboxes it, and the core transformation
/// needs the boxed type to build the `Unbox`.
fn reference_to_value(sym : Sym, ctx : Context) -> Term {
  let id = IdRef(sym.name().name, Span::missing())
  ctx.assign_symbol(id.uid, sym)
  let t = mk_term(Span::missing(), Var(id))
  if ctx.value_type_of(sym.uid()) is Some(tpe) {
    ctx.assign_value_type(t.uid, tpe)
  }
  t
}

///|
fn capabilities_def(ctx : Context, d : Def) -> Def? {
  match d.kind {
    FunDef(id, tparams, vparams, bparams, captures, ret, body) => {
      let caps = ctx
        .bound_capabilities_of(d.uid)
        .map(cap => definition_for_capability(cap, ctx))
      let d2 = copy_def_kind(
        d,
        FunDef(id, tparams, vparams, bparams + caps, captures, ret, body),
        ctx,
      )
      Some(d2)
    }
    _ => None
  }
}

///|
fn copy_def_kind(from : Def, kind : DefKind, ctx : Context) -> Def {
  let to = mk_def(from.span, from.info, kind)
  ctx.copy_annotations(from.uid, to.uid)
  to
}

///|
/// A term referencing a capability bound in the environment.
fn reference_to_capability(cap : Sym, ctx : Context) -> Term {
  let id = IdRef(cap.name().name, Span::missing())
  ctx.assign_symbol(id.uid, cap)
  let t = mk_term(Span::missing(), Var(id))
  if cap is BlockParam(bp) && bp.tpe is Some(bt) {
    ctx.assign_block_type(t.uid, bt)
  }
  t
}

///|
/// A block parameter binding the given capability symbol.
fn definition_for_capability(cap : Sym, ctx : Context) -> BlockParam {
  let id = IdDef(cap.name().name, Span::missing())
  ctx.assign_symbol(id.uid, cap)
  let tpe = match cap {
    BlockParam(bp) => bp.tpe
    _ => None
  }
  {
    id,
    tpe: tpe.map(t => mk_type(Span::missing(), BlockTypeTree(t))),
    is_implicit: false,
  }
}
