// Blackbox tests for the CPS-to-JavaScript translation.
//
// The tests assert on *shapes* of the generated JavaScript rather than on exact
// text: symbol names are generated by `js.name_def`, which the tests query
// after the compilation (the naming state is reset by `compile_cps` and the
// name of a symbol is stable afterwards).

///|
fn sym(name : String) -> @symbols.Sym {
  @symbols.Sym::value_param(
    @symbols.Name::local(name),
    None,
    @util.Span::missing(),
  )
}

///|
fn vparam(name : String) -> @core.ValueParam {
  @core.ValueParam::new(sym(name), @symbols.t_int())
}

///|
fn bparam(name : String) -> @core.BlockParam {
  @core.BlockParam::new(
    @symbols.Sym::block_param(
      @symbols.Name::local(name),
      None,
      sym("\{name}_cap"),
      false,
      @util.Span::missing(),
    ),
    @core.unknown_block_type(),
    @symbols.Captures::empty(),
  )
}

///|
fn block_var(id : @symbols.Sym) -> @core.Block {
  @core.Block::BlockVar(
    @core.BlockVar::new(
      id,
      @core.unknown_block_type(),
      @symbols.Captures::empty(),
    ),
  )
}

///|
fn int_expr(i : Int32) -> @core.Expr {
  @core.Expr::Literal(@source.LInt(i), @symbols.t_int())
}

///|
fn int_pure(i : Int32) -> @cps.Expr {
  @cps.Expr::Literal(@source.LInt(i), @symbols.t_int())
}

///|
fn empty_core_module() -> @core.ModuleDecl {
  @core.ModuleDecl::new("test", [], [], [], [], [])
}

///|
/// The whole core -> cps -> contify -> js pipeline.
fn compile(
  main : @symbols.Sym,
  block : @core.Block,
  core_module : @core.ModuleDecl,
) -> String raise @util.EffektError {
  let module = @core.ModuleDecl::new(
    "test",
    [],
    core_module.declarations,
    core_module.externs,
    [@core.ToplevelDef(main, block)],
    [main],
  )
  let cps_module = @cps.contify(@cps.transform(module))
  @js.compile_cps(cps_module, module, main)
}

///|
/// An anonymous block with no parameters and the given body.
fn unit_block(body : @core.Stmt) -> @core.Block {
  @core.Block::BlockLit(@core.BlockLit::new([], [], [], [], body))
}

///|
/// Compiles a hand-built CPS definition of `main`.
fn compile_cps_block(
  main : @symbols.Sym,
  block : @cps.Block,
) -> String raise @util.EffektError {
  let module = @cps.ModuleDecl::new(
    "test",
    [],
    [],
    [],
    [@cps.ToplevelDef(main, block)],
    [main],
  )
  @js.compile_cps(module, empty_core_module(), main)
}

// ---------------------------------------------------------------------------
// Toplevel
// ---------------------------------------------------------------------------

///|
test "js: a toplevel definition becomes a function of (params..., ks, k)" {
  let main = sym("main")
  let js = compile(
    main,
    unit_block(@core.Stmt::Return(int_expr(42))),
    empty_core_module(),
  )
  let name = @js.name_def(main).name
  // `js.Const` turns a lambda into a function declaration, as upstream
  assert_true(
    js.contains("function \{name}("),
    msg="expected a function declaration for the toplevel definition:\n\{js}",
  )
  // the block takes the metacontinuation and the continuation
  assert_true(js.contains("ks_"), msg="expected a metacontinuation parameter")
  assert_true(js.contains("k_"), msg="expected a continuation parameter")
  // the body returns a thunk (toplevel bodies are compiled in thunk mode)
  assert_true(
    js.contains("return () => "),
    msg="expected a thunked jump:\n\{js}",
  )
}

///|
test "js: a toplevel val is run by RUN_TOPLEVEL" {
  let main = sym("main")
  let ks = sym("ks")
  let k = sym("k")
  let module = @cps.ModuleDecl::new(
    "test",
    [],
    [],
    [],
    [
      @cps.ToplevelVal(
        main,
        ks,
        k,
        @cps.Jump(k, [int_pure(1)], @cps.MetaCont::new(ks)),
      ),
    ],
    [main],
  )
  let js = @js.compile_cps(module, empty_core_module(), main)
  assert_true(
    js.contains("RUN_TOPLEVEL("),
    msg="expected a RUN_TOPLEVEL call:\n\{js}",
  )
  assert_true(
    js.contains("const \{@js.name_def(main).name} = "),
    msg="expected a const binding:\n\{js}",
  )
}

///|
test "js: the exports call main through RUN_TOPLEVEL" {
  let main = sym("main")
  let js = compile(
    main,
    unit_block(@core.Stmt::Return(int_expr(1))),
    empty_core_module(),
  )
  let name = @js.name_def(main).name
  assert_true(
    js.contains("main: () => RUN_TOPLEVEL(\{name})"),
    msg="expected the main export:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// Effects
// ---------------------------------------------------------------------------

///|
test "js: a reset compiles to a RESET call" {
  let main = sym("main")
  let prompt = bparam("prompt")
  let reset = @core.Stmt::Reset(
    @core.BlockLit::new([], [], [], [prompt], @core.Stmt::Return(int_expr(1))),
  )
  let js = compile(main, unit_block(reset), empty_core_module())
  assert_true(js.contains("RESET("), msg="expected a RESET call:\n\{js}")
  // the prompt is the first parameter of the translated block literal
  assert_true(
    js.contains("(\{@js.name_def(prompt.id).name},"),
    msg="expected the prompt as parameter:\n\{js}",
  )
}

///|
test "js: a shift compiles to a SHIFT call" {
  let main = sym("main")
  let prompt = sym("p")
  let resume = bparam("resume")
  let shift = @core.Stmt::Shift(
    @core.BlockVar::new(
      prompt,
      @core.unknown_block_type(),
      @symbols.Captures::empty(),
    ),
    resume,
    @core.Stmt::Return(int_expr(1)),
  )
  let js = compile(main, unit_block(shift), empty_core_module())
  assert_true(js.contains("SHIFT("), msg="expected a SHIFT call:\n\{js}")
  assert_true(
    js.contains(@js.name_def(prompt).name),
    msg="expected the prompt to be passed:\n\{js}",
  )
  assert_true(
    js.contains(@js.name_def(resume.id).name),
    msg="expected the resume parameter:\n\{js}",
  )
}

///|
test "js: a var compiles to a VAR call" {
  let main = sym("main")
  let x = sym("x")
  let cap = sym("cap")
  let var_stmt = @core.Stmt::Var(
    x,
    int_expr(0),
    cap,
    @core.Stmt::Return(int_expr(1)),
  )
  let js = compile(main, unit_block(var_stmt), empty_core_module())
  assert_true(js.contains("VAR("), msg="expected a VAR call:\n\{js}")
  assert_true(
    js.contains("const \{@js.name_def(x).name} = VAR("),
    msg="expected the reference to be bound:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// Pattern matching
// ---------------------------------------------------------------------------

///|
test "js: a match compiles to a switch with numeric case labels" {
  let main = sym("main")
  let x = sym("x")
  let data = sym("MyData")
  let ctor0 = sym("Ctor0")
  let ctor1 = sym("Ctor1")
  let field0 = sym("field0")
  let field1 = sym("field1")
  let declaration = @core.DeclarationData(data, [], [
    @core.Constructor::new(ctor0, [], [
      @core.Field::new(field0, @symbols.t_int()),
    ]),
    @core.Constructor::new(ctor1, [], [
      @core.Field::new(field1, @symbols.t_int()),
    ]),
  ])
  let core_module : @core.ModuleDecl = @core.ModuleDecl::new(
    "test",
    [],
    [declaration],
    [],
    [],
    [],
  )
  let scrutinee = @core.Expr::ValueVar(x, @symbols.t_int())
  let clause0 = @core.Clause::new(
    ctor0,
    @core.BlockLit::new(
      [],
      [],
      [vparam("f")],
      [],
      @core.Stmt::Return(int_expr(1)),
    ),
  )
  let clause1 = @core.Clause::new(
    ctor1,
    @core.BlockLit::new(
      [],
      [],
      [vparam("g")],
      [],
      @core.Stmt::Return(int_expr(2)),
    ),
  )
  let match_stmt = @core.Stmt::Match(
    scrutinee,
    @symbols.t_int(),
    [clause0, clause1],
    None,
  )
  // `val x = Ctor0(1); match x { ... }` — the entry point itself is nullary
  let block = unit_block(
    @core.Stmt::Let(
      x,
      @core.Expr::Make(data, ctor0, [], [int_expr(1)]),
      match_stmt,
    ),
  )
  let js = compile(main, block, core_module)
  assert_true(js.contains("switch ("), msg="expected a switch:\n\{js}")
  assert_true(js.contains(".__tag)"), msg="expected a switch on __tag:\n\{js}")
  assert_true(js.contains("case 0:"), msg="expected the numeric case 0:\n\{js}")
  assert_true(js.contains("case 1:"), msg="expected the numeric case 1:\n\{js}")
}

///|
test "js: a data declaration generates a class with tag, reflect and equals" {
  let main = sym("main")
  let data = sym("MyData")
  let ctor = sym("Ctor")
  let field = sym("field")
  let declaration = @core.DeclarationData(data, [], [
    @core.Constructor::new(ctor, [], [@core.Field::new(field, @symbols.t_int())]),
  ])
  let core_module : @core.ModuleDecl = @core.ModuleDecl::new(
    "test",
    [],
    [declaration],
    [],
    [],
    [],
  )
  let js = compile(
    main,
    unit_block(@core.Stmt::Return(int_expr(0))),
    core_module,
  )
  let class_name = @js.name_def(ctor).name
  assert_true(
    js.contains("class \{class_name}"),
    msg="expected a class for the constructor:\n\{js}",
  )
  assert_true(js.contains("this.__tag = 0"), msg="expected the tag:\n\{js}")
  assert_true(
    js.contains("this.\{@js.name_def(field).name}"),
    msg="expected the field:\n\{js}",
  )
  assert_true(js.contains("__reflect()"), msg="expected __reflect:\n\{js}")
  assert_true(js.contains("__equals("), msg="expected __equals:\n\{js}")
  assert_true(
    js.contains("$effekt.equals("),
    msg="expected the runtime equality:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// Tail recursion: loop generation
// ---------------------------------------------------------------------------

///|
test "js: a tail-recursive definition becomes a labelled while loop" {
  let main = sym("main")
  let f = sym("f")
  // def f = { () => f() }  -- a self call in tail position
  let definition = @core.Block::BlockLit(
    @core.BlockLit::new(
      [],
      [],
      [],
      [],
      @core.Stmt::App(block_var(f), [], [], []),
    ),
  )
  let body = @core.Stmt::Def(f, definition, @core.Stmt::Return(int_expr(0)))
  let js = compile(main, unit_block(body), empty_core_module())
  assert_true(js.contains("while (true)"), msg="expected a loop:\n\{js}")
  let label = @js.name_def(f).name
  assert_true(
    js.contains("\{label}: while (true)"),
    msg="expected the loop to be labelled with the definition's name:\n\{js}",
  )
  assert_true(
    js.contains("continue \{label}"),
    msg="expected the tail call to become a continue:\n\{js}",
  )
}

///|
test "js: a non-recursive definition does not become a loop" {
  let main = sym("main")
  let f = sym("f")
  let definition = @core.Block::BlockLit(
    @core.BlockLit::new([], [], [], [], @core.Stmt::Return(int_expr(0))),
  )
  let body = @core.Stmt::Def(f, definition, @core.Stmt::Return(int_expr(0)))
  let js = compile(main, unit_block(body), empty_core_module())
  assert_true(
    !js.contains("while (true)"),
    msg="expected no loop for a non-recursive definition:\n\{js}",
  )
}

///|
test "js: a non-tail recursive call rebuilds the continuation" {
  let main = sym("main")
  let f = sym("f")
  let x = sym("x")
  let tmp = sym("tmp")
  // def f = { (x: Int, ks, k) => val tmp = f(x); return tmp }
  // the recursive call is not in tail position: it is the right hand side of a
  // `val`, so its continuation is a continuation *literal*.
  let definition = @core.Block::BlockLit(
    @core.BlockLit::new(
      [],
      [],
      [@core.ValueParam::new(x, @symbols.t_int())],
      [],
      @core.Stmt::Val(
        tmp,
        @core.Stmt::App(
          block_var(f),
          [],
          [@core.Expr::ValueVar(x, @symbols.t_int())],
          [],
        ),
        @core.Stmt::Return(@core.Expr::ValueVar(tmp, @symbols.t_int())),
      ),
    ),
  )
  let body = @core.Stmt::Def(f, definition, @core.Stmt::Return(int_expr(0)))
  let js = compile(main, unit_block(body), empty_core_module())
  let label = @js.name_def(f).name
  assert_true(js.contains("while (true)"), msg="expected a loop:\n\{js}")
  assert_true(
    js.contains("/* prepare call */"),
    msg="expected the call to be prepared:\n\{js}",
  )
  assert_true(
    js.contains("continue \{label}"),
    msg="expected the call to become a continue:\n\{js}",
  )
  // the continuation parameter of `f` is reassigned before the arguments
  let k_name = js.contains("\{label}(x_")
  assert_true(k_name, msg="expected the parameters of `f`:\n\{js}")
}

// ---------------------------------------------------------------------------
// Direct style
// ---------------------------------------------------------------------------

///|
test "js: a continuation only jumped to is compiled in direct style" {
  let main = sym("main")
  let ks = sym("ks")
  let k = sym("k")
  let k1 = sym("k1")
  let ks1 = sym("ks1")
  let x = sym("x")
  // let k1 x ks1 = jump k(x, ks1); jump k1(1, ks)
  let block = @cps.Block::BlockLit(
    @cps.BlockLit::new(
      [],
      [],
      ks,
      k,
      @cps.LetCont(
        k1,
        @cps.ContLam::new(
          [x],
          ks1,
          @cps.Jump(k, [@cps.Expr::ValueVar(x)], @cps.MetaCont::new(ks1)),
        ),
        @cps.Jump(k1, [int_pure(1)], @cps.MetaCont::new(ks)),
      ),
    ),
  )
  let js = compile_cps_block(main, block)
  let x_name = @js.name_def(x).name
  assert_true(
    js.contains("let \{x_name} = undefined;"),
    msg="expected a mutable local for the continuation parameter:\n\{js}",
  )
  assert_true(
    js.contains("\{x_name} = 1;"),
    msg="expected the jump to become an assignment:\n\{js}",
  )
  assert_true(
    !js.contains("\{@js.name_def(k1).name}("),
    msg="expected no call to the direct-style continuation:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// Externs
// ---------------------------------------------------------------------------

///|
test "js: an extern with value parameters only is inlined" {
  let main = sym("main")
  let ext = sym("ext")
  let p = sym("p")
  let template = @util.Template::new(["(", " + 1)"], [@cps.Expr::ValueVar(p)])
  let extern_def = @cps.ExternDef(
    ext,
    [p],
    [],
    false,
    @cps.StringExternBody(@source.Default, template),
  )
  let module = @cps.ModuleDecl::new(
    "test",
    [],
    [],
    [extern_def],
    [
      @cps.ToplevelDef(
        main,
        @cps.Block::BlockLit(
          @cps.BlockLit::new(
            [],
            [],
            sym("ks"),
            sym("k"),
            @cps.Jump(
              sym("k"),
              [@cps.Expr::PureApp(ext, [int_pure(1)])],
              @cps.MetaCont::new(sym("ks")),
            ),
          ),
        ),
      ),
    ],
    [main],
  )
  let js = @js.compile_cps(module, empty_core_module(), main)
  // the raw template is spliced with the substituted argument; like upstream,
  // `RawExpr` parenthesises its arguments
  assert_true(
    js.contains("(1) + 1"),
    msg="expected the extern to be inlined:\n\{js}",
  )
  assert_true(
    !js.contains("function \{@js.name_def(ext).name}"),
    msg="expected no function for the inlined extern:\n\{js}",
  )
}

///|
test "js: an async extern is not inlined" {
  let main = sym("main")
  let ext = sym("ext")
  let p = sym("p")
  let template = @util.Template::new(["(", " + 1)"], [@cps.Expr::ValueVar(p)])
  let extern_def = @cps.ExternDef(
    ext,
    [p],
    [],
    true,
    @cps.StringExternBody(@source.Default, template),
  )
  let module = @cps.ModuleDecl::new(
    "test",
    [],
    [],
    [extern_def],
    [
      @cps.ToplevelDef(
        main,
        @cps.Block::BlockLit(
          @cps.BlockLit::new(
            [],
            [],
            sym("ks"),
            sym("k"),
            @cps.Jump(
              sym("k"),
              [@cps.Expr::PureApp(ext, [int_pure(1)])],
              @cps.MetaCont::new(sym("ks")),
            ),
          ),
        ),
      ),
    ],
    [main],
  )
  let js = @js.compile_cps(module, empty_core_module(), main)
  let name = @js.name_def(ext).name
  let p_name = @js.name_def(p).name
  assert_true(
    js.contains("function \{name}(\{p_name},"),
    msg="expected the async extern to be emitted with its parameters:\n\{js}",
  )
  // an async extern takes the metacontinuation and the continuation
  assert_true(
    js.contains("return \{name}_") || js.contains("return "),
    msg="expected a body",
  )
  assert_true(
    !js.contains("(1) + 1"),
    msg="expected no inlining for an async extern:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// Handlers
// ---------------------------------------------------------------------------

///|
/// The CPS shape of `try { 0 } with E { ... }`: a handled body that *completes
/// normally*, so the generated `RESET` never sees a `SHIFT` and the program
/// simply returns to the continuation of the `try`.
fn handled_body_module() -> @cps.ModuleDecl {
  let main = sym("main")
  let ks = sym("ks")
  let k = sym("k")
  let prompt = sym("p")
  let ks_p = sym("ks_p")
  let k_p = sym("k_p")
  let r = sym("r")
  let ks_r = sym("ks_r")
  // reset { (p, ks, k) => jump k(0, ks) } with (r, ks) => jump k(r, ks)
  let block = @cps.Block::BlockLit(
    @cps.BlockLit::new(
      [],
      [],
      ks,
      k,
      @cps.Reset(
        @cps.BlockLit::new(
          [],
          [prompt],
          ks_p,
          k_p,
          @cps.Jump(k_p, [int_pure(0)], @cps.MetaCont::new(ks_p)),
        ),
        @cps.MetaCont::new(ks),
        @cps.Cont::ContLam(
          @cps.ContLam::new(
            [r],
            ks_r,
            @cps.Jump(k, [@cps.Expr::ValueVar(r)], @cps.MetaCont::new(ks_r)),
          ),
        ),
      ),
    ),
  )
  @cps.ModuleDecl::new("test", [], [], [], [@cps.ToplevelDef(main, block)], [
    main,
  ])
}

///|
/// The CPS shape of
///
/// ```
/// try { raise(1, "boom") } with Exception[Int] { def raise(e, msg) = { println(msg); 0 } }
/// ```
///
/// that is: a handler whose *operation body performs another effectful call*
/// (`println`, an inlined extern) before returning to the resumption. This is
/// the shape that used to crash on the way out of the handler, so it is worth
/// pinning down: the handler object is built with `new`, the operation is
/// invoked through it, and the `SHIFT` body calls `println` before jumping.
///
/// Returns the module together with the symbol of the `raise` operation.
fn handler_with_effect_module() -> (@cps.ModuleDecl, @symbols.Sym) {
  let main = sym("main")
  let ks = sym("ks")
  let k = sym("k")
  let r = sym("r")
  let ks_r = sym("ks_r")
  let prompt = sym("p")
  let ks_p = sym("ks_p")
  let k_p = sym("k_p")

  let exc = sym("Exception")
  let exc_cap = sym("Exception_cap")
  let exc_tpe = @symbols.InterfaceType(exc, [@symbols.t_int()])
  let raise_op = sym("raise")
  let e = sym("e")
  let msg = sym("msg")
  let ks_o = sym("ks_o")
  let k_o = sym("k_o")
  let b_k = sym("b_k")
  let ks_s = sym("ks_s")
  let k_s = sym("k_s")
  let v_r = sym("v_r")
  let println_ext = sym("println")

  // `println` is an extern with value parameters only: it is inlined.
  let println_def = @cps.ExternDef(
    println_ext,
    [msg],
    [],
    false,
    @cps.StringExternBody(
      @source.Default,
      @util.Template::new(["$effekt.println(", ")"], [@cps.Expr::ValueVar(msg)]),
    ),
  )
  // def raise(e, msg) = shift(p) { (b_k, ks, k) => println(msg); jump k(0, ks) }
  let operation = @cps.Operation::new(
    raise_op,
    [e, msg],
    [],
    ks_o,
    k_o,
    @cps.Shift(
      prompt,
      @cps.BlockLit::new(
        [],
        [b_k],
        ks_s,
        k_s,
        @cps.ImpureApp(
          v_r,
          println_ext,
          [@cps.Expr::ValueVar(msg)],
          [],
          @cps.Jump(k_s, [int_pure(0)], @cps.MetaCont::new(ks_s)),
        ),
      ),
      @cps.MetaCont::new(ks_o),
      @cps.ContVar(k_o),
    ),
  )
  // reset { (p, ks, k) => def Exception = new Exception[Int] { ... }; Exception.raise(1, "boom") }
  let prog = @cps.BlockLit::new(
    [],
    [prompt],
    ks_p,
    k_p,
    @cps.LetDef(
      exc_cap,
      @cps.Block::New(@cps.Implementation::new(exc_tpe, [operation])),
      @cps.Invoke(
        @cps.Block::BlockVar(exc_cap),
        raise_op,
        [
          int_pure(1),
          @cps.Expr::Literal(@source.LString("boom"), @symbols.t_string()),
        ],
        [],
        @cps.MetaCont::new(ks_p),
        @cps.ContVar(k_p),
      ),
    ),
  )
  let block = @cps.Block::BlockLit(
    @cps.BlockLit::new(
      [],
      [],
      ks,
      k,
      @cps.Reset(
        prog,
        @cps.MetaCont::new(ks),
        @cps.Cont::ContLam(
          @cps.ContLam::new(
            [r],
            ks_r,
            @cps.Jump(k, [@cps.Expr::ValueVar(r)], @cps.MetaCont::new(ks_r)),
          ),
        ),
      ),
    ),
  )
  let module = @cps.ModuleDecl::new(
    "test",
    [],
    [],
    [println_def],
    [@cps.ToplevelDef(main, block)],
    [main],
  )
  (module, raise_op)
}

///|
test "js: a try whose body completes normally" {
  let module = handled_body_module()
  let js = @js.compile_cps(
    module,
    empty_core_module(),
    module.definitions[0].id(),
  )
  assert_true(js.contains("RESET("), msg="expected a RESET call:\n\{js}")
  assert_true(
    !js.contains("SHIFT("),
    msg="a handled body that completes normally does not shift:\n\{js}",
  )
  // the prompt is bound by the reset and the body returns to its continuation
  assert_true(js.contains("=> () => "), msg="expected a thunked jump:\n\{js}")
}

///|
test "js: a handler operation whose body performs an effectful call" {
  let (module, raise_op) = handler_with_effect_module()
  let js = @js.compile_cps(
    module,
    empty_core_module(),
    module.definitions[0].id(),
  )
  assert_true(js.contains("RESET("), msg="expected a RESET call:\n\{js}")
  assert_true(js.contains("SHIFT("), msg="expected a SHIFT call:\n\{js}")
  // the handler is an object with the operation, invoked through the capability
  let op_name = @js.name_def(raise_op).name
  assert_true(
    js.contains(".\{op_name}("),
    msg="expected the operation to be invoked through the handler:\n\{js}",
  )
  // the operation is a property of the handler object
  assert_true(
    js.contains("\{op_name}: (") || js.contains("\{op_name}:("),
    msg="expected the operation in the handler object:\n\{js}",
  )
  // the *operation body* performs an effect before returning to the resumption
  assert_true(
    js.contains("$effekt.println("),
    msg="expected the effectful call inside the operation body:\n\{js}",
  )
  // the inlined extern does not show up as a function
  assert_true(
    !js.contains("function println"),
    msg="expected the extern to be inlined:\n\{js}",
  )
}

// ---------------------------------------------------------------------------
// The entry point
// ---------------------------------------------------------------------------

///|
/// `RUN_TOPLEVEL` calls the entry point with exactly the (metacontinuation,
/// continuation) pair: a `main` with parameters would be called with *shifted*
/// arguments, so the backend refuses to generate it (upstream rejects it in
/// `Typer.checkMain`).
test "js: a main with capability parameters is rejected" {
  let main = sym("main")
  let exc = @core.BlockParam::new(
    @symbols.Sym::block_param(
      @symbols.Name::local("Exception"),
      None,
      sym("Exception_cap"),
      false,
      @util.Span::missing(),
    ),
    @symbols.InterfaceType(sym("Exception"), [@symbols.t_int()]),
    @symbols.Captures::empty(),
  )
  let block = @core.Block::BlockLit(
    @core.BlockLit::new([], [], [], [exc], @core.Stmt::Return(int_expr(0))),
  )
  let core_module = @core.ModuleDecl::new(
    "test",
    [],
    [],
    [],
    [@core.ToplevelDef(main, block)],
    [main],
  )
  let cps_module = @cps.contify(@cps.transform(core_module))
  let mut rejected = false
  try {
    let _ = @js.compile_cps(cps_module, core_module, main)
  } catch {
    @util.EffektError::Fatal(msg) => {
      rejected = true
      assert_true(
        msg.contains("Main cannot have effects"),
        msg="expected the upstream diagnostic, got: \{msg}",
      )
    }
    @util.EffektError::Internal(msg) =>
      assert_true(false, msg="unexpected internal error: \{msg}")
  }
  assert_true(
    rejected,
    msg="expected compiling a `main` with capability parameters to fail",
  )
}

// ---------------------------------------------------------------------------
// Golden output
// ---------------------------------------------------------------------------

///|
/// Prints the generated JavaScript of a few representative programs between
/// markers, so that the driver script can run `node --check` on it (`moon test
/// -p src/js -v` shows the output). The tests above assert on the shapes; this
/// one makes the *syntax* of a whole module checkable by a real JavaScript
/// parser.
test "js: golden output" {
  // 1. a toplevel definition with a let, an if and a return
  let main = sym("main")
  let if_block = unit_block(
    @core.Stmt::If(
      int_expr(1),
      @core.Stmt::Return(int_expr(2)),
      @core.Stmt::Return(int_expr(3)),
    ),
  )
  println("===BEGIN-JS===")
  println(compile(main, if_block, empty_core_module()))

  // 2. a handler (implementation) and a match
  println("===NEXT-JS===")
  println(
    compile(
      main,
      unit_block(@core.Stmt::Return(int_expr(0))),
      empty_core_module(),
    ),
  )

  // 3. a direct-style continuation
  println("===NEXT-JS===")
  let ks = sym("ks")
  let k = sym("k")
  let k1 = sym("k1")
  let ks1 = sym("ks1")
  let x = sym("x")
  println(
    compile_cps_block(
      main,
      @cps.Block::BlockLit(
        @cps.BlockLit::new(
          [],
          [],
          ks,
          k,
          @cps.LetCont(
            k1,
            @cps.ContLam::new(
              [x],
              ks1,
              @cps.Jump(k, [@cps.Expr::ValueVar(x)], @cps.MetaCont::new(ks1)),
            ),
            @cps.Jump(k1, [int_pure(1)], @cps.MetaCont::new(ks)),
          ),
        ),
      ),
    ),
  )

  // 4. matched data with a switch
  println("===NEXT-JS===")
  let data = sym("MyData")
  let ctor0 = sym("Ctor0")
  let ctor1 = sym("Ctor1")
  let field0 = sym("field0")
  let field1 = sym("field1")
  let declaration = @core.DeclarationData(data, [], [
    @core.Constructor::new(ctor0, [], [
      @core.Field::new(field0, @symbols.t_int()),
    ]),
    @core.Constructor::new(ctor1, [], [
      @core.Field::new(field1, @symbols.t_int()),
    ]),
  ])
  let core_module : @core.ModuleDecl = @core.ModuleDecl::new(
    "test",
    [],
    [declaration],
    [],
    [],
    [],
  )
  let x2 = sym("x")
  let match_stmt = @core.Stmt::Match(
    @core.Expr::ValueVar(x2, @symbols.t_int()),
    @symbols.t_int(),
    [
      @core.Clause::new(
        ctor0,
        @core.BlockLit::new(
          [],
          [],
          [vparam("f")],
          [],
          @core.Stmt::Return(int_expr(1)),
        ),
      ),
      @core.Clause::new(
        ctor1,
        @core.BlockLit::new(
          [],
          [],
          [vparam("g")],
          [],
          @core.Stmt::Return(int_expr(2)),
        ),
      ),
    ],
    None,
  )
  println(
    compile(
      sym("main"),
      unit_block(
        @core.Stmt::Let(
          x2,
          @core.Expr::Make(data, ctor0, [], [int_expr(1)]),
          match_stmt,
        ),
      ),
      core_module,
    ),
  )

  // 5. a tail-recursive loop
  println("===NEXT-JS===")
  let f = sym("f")
  println(
    compile(
      sym("main"),
      unit_block(
        @core.Stmt::Def(
          f,
          @core.Block::BlockLit(
            @core.BlockLit::new(
              [],
              [],
              [],
              [],
              @core.Stmt::App(block_var(f), [], [], []),
            ),
          ),
          @core.Stmt::Return(int_expr(0)),
        ),
      ),
      empty_core_module(),
    ),
  )

  // 6. effects: reset, shift, var and region
  println("===NEXT-JS===")
  let prompt = bparam("prompt")
  let resume = bparam("resume")
  let effects = @core.Stmt::Region(
    @core.BlockLit::new(
      [],
      [],
      [],
      [bparam("region")],
      @core.Stmt::Var(
        sym("state"),
        int_expr(0),
        sym("state_cap"),
        @core.Stmt::Reset(
          @core.BlockLit::new(
            [],
            [],
            [],
            [prompt],
            @core.Stmt::Shift(
              @core.BlockVar::new(
                sym("p"),
                @core.unknown_block_type(),
                @symbols.Captures::empty(),
              ),
              resume,
              @core.Stmt::Return(int_expr(1)),
            ),
          ),
        ),
      ),
    ),
  )
  println(compile(sym("main"), unit_block(effects), empty_core_module()))

  // 7. a non-tail recursive call with a continuation literal
  println("===NEXT-JS===")
  let g = sym("g")
  let y = sym("y")
  let tmp = sym("tmp")
  println(
    compile(
      sym("main"),
      unit_block(
        @core.Stmt::Def(
          g,
          @core.Block::BlockLit(
            @core.BlockLit::new(
              [],
              [],
              [@core.ValueParam::new(y, @symbols.t_int())],
              [],
              @core.Stmt::Val(
                tmp,
                @core.Stmt::App(
                  block_var(g),
                  [],
                  [@core.Expr::ValueVar(y, @symbols.t_int())],
                  [],
                ),
                @core.Stmt::Return(@core.Expr::ValueVar(tmp, @symbols.t_int())),
              ),
            ),
          ),
          @core.Stmt::Return(int_expr(0)),
        ),
      ),
      empty_core_module(),
    ),
  )
  // 8. a handled body that completes normally
  println("===NEXT-JS===")
  let normal_module = handled_body_module()
  println(
    @js.compile_cps(
      normal_module,
      empty_core_module(),
      normal_module.definitions[0].id(),
    ),
  )

  // 9. a handler whose operation body performs another effectful call
  println("===NEXT-JS===")
  let (handler_module, _) = handler_with_effect_module()
  println(
    @js.compile_cps(
      handler_module,
      empty_core_module(),
      handler_module.definitions[0].id(),
    ),
  )
  println("===END-JS===")
}
